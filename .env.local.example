# Optional football-data.org API key for live scores
FOOTBALL_DATA_API_KEY=

# Dev console controls
# In production builds, set ENABLE_DEV_CONSOLE=true to expose /dev-console.
# If you enable it in production you MUST set DEV_CONSOLE_PASSWORD: the console
# fails CLOSED (stays locked) when enabled without a password.
ENABLE_DEV_CONSOLE=false

# Password for /dev-console (required when ENABLE_DEV_CONSOLE=true in production)
DEV_CONSOLE_PASSWORD=

# Draft page + /api/draft protection.
# REQUIRED in production: when unset, the draft fails CLOSED (login is rejected
# and the API returns 401). Optional in local dev, where it stays open.
DRAFT_SECRET=

# Cron auth for /api/cron/refresh. Vercel Cron sends `Authorization: Bearer
# <CRON_SECRET>`; the route returns 401 without it, so the public cannot trigger
# the upstream-touching refresh. Set this in the Vercel project.
CRON_SECRET=

# Optional helper for scripts/draft-smoke.mjs
# Point this at your deployed site when you want to inspect production persistence.
DRAFT_API_BASE_URL=

# ── Vercel KV (draft persistence) ─────────────────────────────────────────────
# Provisioned automatically when you attach a Vercel KV store in the dashboard.
# In local development these are optional — falls back to data/draft.json.
# In production (Vercel) these must be set for draft writes to persist.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
