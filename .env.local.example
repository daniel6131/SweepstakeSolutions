# Optional football-data.org API key for live scores
FOOTBALL_DATA_API_KEY=

# ── Image generation (scripts/gen-image.mjs) ──────────────────────────────────
# Default provider is Pollinations (FLUX) — needs NO key, no billing, $0.
#
# Optional: Cloudflare Workers AI (FLUX.1-schnell, higher quality, free tier).
#   Get both from https://dash.cloudflare.com → AI → Workers AI / API Tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
#
# Optional: Gemini. NOTE — Gemini image generation has NO free API tier (quota 0);
# it only works with billing enabled. Free key (text only): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Dev console controls
# In production builds, set ENABLE_DEV_CONSOLE=true to expose /dev-console
ENABLE_DEV_CONSOLE=false

# Optional password for /dev-console
DEV_CONSOLE_PASSWORD=

# Draft page protection (replaces ?key= query-string auth)
DRAFT_SECRET=

# Optional helper for scripts/draft-smoke.mjs
# Point this at your deployed site when you want to inspect production persistence.
DRAFT_API_BASE_URL=

# ── Vercel KV (draft persistence) ─────────────────────────────────────────────
# Provisioned automatically when you attach a Vercel KV store in the dashboard.
# In local development these are optional — falls back to data/draft.json.
# In production (Vercel) these must be set for draft writes to persist.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
